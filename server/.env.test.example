# Copy this file to .env.test and fill in the values.
# DATABASE_PATH is intentionally omitted — vitest.config.e2e.ts forces :memory:

# ── Clerk ──────────────────────────────────────────────────────────────────────
# Your Clerk DEVELOPMENT instance keys (never use production keys in tests)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# How to get CLERK_TEST_SESSION_TOKEN:
#   1. Start your dev server and sign in with your test user account
#   2. Open DevTools → Network → any authenticated request
#      Look at the Authorization header: "Bearer <token>"
#   3. Paste that token below (valid for ~1 hour in dev mode)
CLERK_TEST_SESSION_TOKEN=

# The Clerk user ID for the test account above (found in Clerk Dashboard → Users)
CLERK_TEST_USER_ID=user_...

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Use your Stripe TEST key (sk_test_...) — CASH bookings don't call Stripe,
# but the service still needs a key to initialise the SDK.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
